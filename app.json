{
  "expo": {
    "name": "KompassFlow",
    "slug": "kompassflow-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kompassflow",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF7F1",
    "androidStatusBar": {
      "backgroundColor": "#FFF7F1",
      "barStyle": "dark-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mx.kompassflow.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "mx.kompassflow.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "server",
      "name": "KompassFlow",
      "shortName": "KompassFlow",
      "description": "Reservas, cupos, cobros y asistencia para academias e instructores de baile.",
      "lang": "es",
      "themeColor": "#F5EFE3",
      "backgroundColor": "#F5EFE3",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "KompassFlow necesita tus fotos para elegir la portada de tu academia y tu foto de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KompassFlow usa tu ubicación para mostrarte las academias y clases más cercanas."
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dfc0d842-9b15-4575-8edb-fc9f280907ac"
      }
    },
    "owner": "kompassflow",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dfc0d842-9b15-4575-8edb-fc9f280907ac",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
