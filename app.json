{
  "expo": {
    "name": "KompasFlow",
    "slug": "kompasflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kompasflow",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF7F1",
    "androidStatusBar": {
      "backgroundColor": "#FFF7F1",
      "barStyle": "dark-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.expostarter"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.expostarter"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "KompasFlow necesita tus fotos para elegir la portada de tu academia y tu foto de perfil."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KompasFlow usa tu ubicación para mostrarte las academias y clases más cercanas."
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
