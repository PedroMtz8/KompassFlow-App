# Copia este archivo a .env (local) y a las variables de entorno de EAS (producción).
# Expo CLI carga .env automáticamente. Las variables EXPO_PUBLIC_* viajan al cliente;
# el resto SOLO existe en el servidor (rutas +api.ts).

# ── Cliente ─────────────────────────────────────────────────────────────
# URL pública de tu API/servidor. Opcional en desarrollo (se deduce del dev server);
# OBLIGATORIA en builds nativas de producción (p. ej. https://tu-app.expo.app).
EXPO_PUBLIC_API_URL=

# ── Base de datos (Turso / libSQL) ─────────────────────────────────────
# Desarrollo local:  turso dev --db-file local.db   -> http://127.0.0.1:8080
# Producción:        libsql://<tu-db>-<org>.turso.io  +  token
TURSO_DATABASE_URL=http://127.0.0.1:8080
TURSO_AUTH_TOKEN=

# ── Better Auth ────────────────────────────────────────────────────────
# Genera el secreto con:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública del servidor (en producción). En desarrollo puede omitirse.
BETTER_AUTH_URL=

# ── Login con Google (opcional: si faltan, el botón responde con error) ─
# Cliente OAuth tipo "Aplicación web". URI de redirección autorizados:
#   http://localhost:8081/api/auth/callback/google
#   https://<tu-dominio>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe: suscripciones SaaS de las academias (opcional: sin claves la facturación queda apagada) ─
# Claves en modo prueba: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Webhook en desarrollo: stripe listen --api-key $STRIPE_SECRET_KEY --print-secret   (imprime whsec_…)
# y para recibir eventos: stripe listen --api-key $STRIPE_SECRET_KEY --forward-to localhost:8081/api/auth/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Secreto del webhook de CUENTAS CONECTADAS (cobros con tarjeta de los alumnos). En producción es distinto al anterior; en desarrollo se omite (usa el mismo).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Ids de precio mensual (price_…) de cada plan, en MXN
# Los ids de precio se crean con: bun --env-file=.env scripts/stripe-setup.ts
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Cobros con tarjeta de los alumnos a las academias (Stripe Connect): comisión de la plataforma en puntos base (100 = 1%). 0 = sin comisión.
PLATFORM_FEE_BPS=0
# Comisión por plan de la academia (opcional; si falta usa PLATFORM_FEE_BPS). 100 = 1%. Ej.: Business sin comisión.
# PLATFORM_FEE_BPS_FREE=500
# PLATFORM_FEE_BPS_STARTER=350
# PLATFORM_FEE_BPS_PRO=200
# PLATFORM_FEE_BPS_BUSINESS=0

# ── Cloudflare R2: archivos (portada de la academia, foto de perfil). Opcional: sin estas variables se desactiva ─
# Dashboard de Cloudflare → R2. El ID de cuenta aparece en la barra lateral de R2.
R2_ACCOUNT_ID=
# R2 → «Manage R2 API Tokens» → token con permiso «Object Read & Write» sobre ESTE bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública del bucket (sin «/» al final): el dominio r2.dev del bucket o un dominio propio. Ej. https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# ── Correo transaccional (Resend + React Email) ────────────────────────
# Sin RESEND_API_KEY no se envía nada: en desarrollo el correo se imprime en la consola del servidor (con sus enlaces),
# así puedes probar recuperar contraseña, confirmar correo, invitaciones y cancelaciones sin configurar nada.
# Clave: https://resend.com/api-keys   ·   Dominio verificado: https://resend.com/domains
RESEND_API_KEY=
# Remitente. Con el dominio sin verificar, Resend solo deja enviar desde onboarding@resend.dev a tu propio correo.
EMAIL_FROM="KompasFlow <no-reply@tu-dominio.com>"
# URL pública de la app web: los correos enlazan aquí (p. ej. https://tu-app.expo.app). Si falta, usa BETTER_AUTH_URL.
APP_URL=

# ── Textos legales (aviso de privacidad y términos): completa estos datos antes de publicar ──
EXPO_PUBLIC_LEGAL_NAME=
EXPO_PUBLIC_LEGAL_ADDRESS=
EXPO_PUBLIC_SUPPORT_EMAIL=

# ── Monitoreo de errores (Sentry). Opcional: sin DSN los errores solo quedan en el log del servidor ──
# Proyecto de tipo "Node.js"/genérico → Settings → Client Keys (DSN). Los errores de la app llegan por /api/client-errors.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
APP_VERSION=

# ── Respaldos (scripts/backup.ts). R2_BACKUP_BUCKET debe ser un bucket PRIVADO y distinto de R2_BUCKET ──
R2_BACKUP_BUCKET=
# Cifra el respaldo (obligatoria al subir a R2). Genérala con:  openssl rand -base64 32   y guárdala aparte: sin ella no se restaura.
BACKUP_ENCRYPTION_KEY=
BACKUP_KEEP=14

# ── Recordatorios y avisos ───────────────────────────────────────────────
# Secreto con el que el planificador (GitHub Actions, .github/workflows/reminders.yml) llama a /api/jobs/reminders.
# Genera uno con:  openssl rand -base64 32     Sin él esa ruta responde 503 y no salen recordatorios.
CRON_SECRET=

# Administradores de la plataforma (correos separados por coma, con el correo confirmado): editan planes y comisiones desde la app.
PLATFORM_ADMIN_EMAILS=
