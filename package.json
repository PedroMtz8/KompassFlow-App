    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "stripe": "22",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.2.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--max-old-space-size=8192 expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "NODE_OPTIONS=--max-old-space-size=8192 expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "db:generate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs studio",
    "auth:generate": "npx auth@latest generate --config src/server/auth/index.ts --output src/server/db/schema/auth.ts -y",
    "build:web": "expo export --platform web",
    "deploy": "expo export --platform web && npx eas-cli@latest deploy",
    "deploy:prod": "expo export --platform web && npx eas-cli@latest deploy --prod",
    "test": "bun scripts/test-all.ts",
    "api": "bun scripts/serve-api.ts",
    "test:security": "bun --env-file=.env scripts/security-check.ts",
    "test:concurrency": "bun --env-file=.env scripts/concurrency-check.ts",
    "test:payments": "bun --env-file=.env scripts/payments-check.ts",
    "test:storage": "bun scripts/storage-check.ts",
    "test:uploads": "bun --env-file=.env scripts/uploads-check.ts",
    "test:series": "bun --env-file=.env scripts/series-check.ts",
    "test:timezone": "bun --env-file=.env scripts/timezone-check.ts",
    "test:checkin": "bun --env-file=.env scripts/checkin-check.ts",
    "test:accounts": "bun --env-file=.env scripts/accounts-check.ts",
    "test:shared": "bun --env-file=.env scripts/shared-pass-check.ts",
    "test:roles": "bun --env-file=.env scripts/roles-check.ts",
    "test:extras": "bun --env-file=.env scripts/extras-check.ts",
    "test:email": "bun --env-file=.env scripts/email-check.ts",
    "test:deletion": "bun --env-file=.env scripts/deletion-check.ts",
    "test:validation": "bun --env-file=.env scripts/validation-check.ts",
    "test:smoke": "bun scripts/test-all.ts smoke --remote",
    "test:backup": "bun scripts/test-all.ts backup",
    "test:monitoring": "bun scripts/test-all.ts monitoring",
    "backup": "bun --env-file=.env scripts/backup.ts",
    "restore": "bun scripts/restore.ts",
    "db:seed": "bun --env-file=.env src/server/db/seed.ts",
    "db:seed:demo": "bun --env-file=.env src/server/db/seed-demo.ts",
    "preflight": "bun scripts/preflight.ts"
  },
  "private": true
}
