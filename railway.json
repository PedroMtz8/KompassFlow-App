{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "NODE_OPTIONS=--max-old-space-size=4096 bun run build:web"
  },
  "deploy": {
    "startCommand": "NODE_ENV=production bun scripts/serve.ts",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
